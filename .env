# InternOps AI Configuration
# Database configuration
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/internops
# SQLite default: sqlite:///./internops.db
DATABASE_URL=sqlite:///./internops.db

# Email settings
# Keep DRY_RUN_EMAIL=true until SMTP is verified
DRY_RUN_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=internops@example.com
SMTP_PASSWORD=secret
SMTP_FROM_EMAIL=no-reply@internops.local
SMTP_USE_TLS=true

# LLM / Anthropic Claude API
ANTHROPIC_API_KEY=

# App settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
